    "hard02b_wrong_answer_after_short_dropout": {
      "description": "RKO drops frames for 3.5 s; the next answer is distinctive but 128 m off, later answers are correct (one reading of the outdoor_hard_02b failure)",
      "recovery_required": true
    },
    "hard02b_wrong_answer_inside_dropout": {
      "description": "the wrong answer comes from a scan inside the odometry gap, so no bridged pose covers it; later answers are correct (the other reading)",
      "recovery_required": true
    },
    "kidnap_covered_carry": {
      "description": "sensor covered and carried 68 m for 30 s (odom stops, then restarts at identity); every answer after the cover is correct",
      "recovery_required": true
    },
    "kidnap_stationary_alias_across_gap": {
      "description": "an answer before the cover, then a wrong answer where the robot would be had it not been carried; correct answers follow",
      "recovery_required": false
    },
    "kidnap_answers_during_cover": {
      "description": "G2 answers on two sparse covered scans (weak, not gated) before the odometry resumes; correct answers follow",
      "recovery_required": true
    },
    "kidnap_intermittent_odometry": {
      "description": "after the carry the odometry drops out (and restarts) between every two answers; all answers are correct",
      "recovery_required": true
    },
    "continuous_alias_then_correct": {
      "description": "no dropout: an aliased answer 65 m off, then correct answers (#178)",
      "recovery_required": true
    },
    "no_external_odometry": {
      "description": "no odom TF and no bridge at all: one gated answer resets, as before #178",
      "recovery_required": true
    },
    "repeated_alias_across_short_dropout": {
      "description": "walking at 0.3 m/s; the same wrong place is answered before and after a 3.5 s odometry gap, then a correct answer",
